    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.1.4",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
