{
  "name": "vue-auth-architecture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "一个以 稳定性、安全性、可解释性 为核心的 Vue 3 企业级前端八层架构示例。适用于构建真实中后台系统，也可作为 前端面试的完整架构讲解项目",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api": "orval --config orval.config.cjs",
    "gen:api:legacy": "node scripts/swagger-generate.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@tanstack/vue-query": "^5.92.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.1.0",
    "@xstate/vue": "^5.0.0",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.13.0",
    "pinia": "^3.0.4",
    "sass": "^1.97.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "xstate": "^5.25.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@iconify-icons/icon-park-outline": "^1.2.11",
